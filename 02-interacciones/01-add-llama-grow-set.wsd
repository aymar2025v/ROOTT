@startuml addgrow
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825
skinparam sequenceArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #00695C
skinparam sequenceLifeLineBackgroundColor #E0F2F1
skinparam sequenceParticipantBackgroundColor #B2DFDB
skinparam sequenceParticipantBorderColor #00695C
skinparam actorBackgroundColor #E0F2F1
skinparam actorBorderColor #00695C
skinparam sequenceGroupBorderColor #00695C
skinparam sequenceGroupBackgroundColor #E0F2F1

title Interacción add(i, x) → grow() → set/get\nEjemplo: n = 3, i = 1, x = 99, r = 2

actor "Usuario" as USR
participant "RootishArrayStack" as RAS
participant "grow()" as GROW
participant "set/get" as SETGET
participant "i2b" as I2B
participant "blocks\n(ArrayStack<T*>)" as BLK
participant "Sistema\n(new)" as SYS

USR -> RAS : add(1, 99)
activate RAS

note right of RAS
  n = 3
  blocks.size() = 2
  Capacidad = 2·3/2 = 3
  n + 1 = 4 > 3 → hace falta grow()
end note

group Fase 1: asegurar capacidad
  RAS -> GROW : grow()
  activate GROW

  GROW -> BLK : size()
  activate BLK
  BLK --> GROW : 2
  deactivate BLK

  note right of GROW
    nuevo tamaño = 2 + 1 = 3
  end note

  GROW -> SYS : new T[3]
  activate SYS
  SYS --> GROW : T* bloque 2
  deactivate SYS

  GROW -> BLK : add(2, ptr_bloque2)
  activate BLK
  note right of BLK
    Se inserta al final.
    blocks.size() = 3.
  end note
  BLK --> GROW : ok
  deactivate BLK

  GROW --> RAS : fin
  deactivate GROW

  note right of RAS
    Capacidad ahora = 3·4/2 = 6
  end note
end

RAS -> RAS : n++
note right of RAS
  n pasa de 3 a 4.
end note

group Fase 2: desplazar a la derecha
  loop j = n−1 = 3; j > i = 1; j−−

    RAS -> SETGET : set(j, get(j − 1))
    activate SETGET

    SETGET -> I2B : i2b(j)
    activate I2B
    I2B --> SETGET : b_dest
    deactivate I2B

    SETGET -> BLK : get(b_dest)
    activate BLK
    BLK --> SETGET : T* destino
    deactivate BLK

    SETGET -> I2B : i2b(j − 1)
    activate I2B
    I2B --> SETGET : b_orig
    deactivate I2B

    SETGET -> BLK : get(b_orig)
    activate BLK
    BLK --> SETGET : T* origen
    deactivate BLK

    note right of SETGET
      Copia el elemento de
      j−1 a j.
    end note

    SETGET --> RAS : ok
    deactivate SETGET
  end
end

group Fase 3: colocar el nuevo valor
  RAS -> SETGET : set(1, 99)
  activate SETGET

  SETGET -> I2B : i2b(1)
  activate I2B
  I2B --> SETGET : b
  deactivate I2B

  SETGET -> BLK : get(b)
  activate BLK
  BLK --> SETGET : T* bloque
  deactivate BLK

  note right of SETGET
    *(ptr + j) = 99
    Devuelve el valor viejo
    (que se descarta en add).
  end note

  SETGET --> RAS : ok
  deactivate SETGET
end

RAS --> USR : void
deactivate RAS

note right of USR
  Estado final:
  n = 4
  blocks.size() = 3
  Elemento 99 en posición 1.
end note

@enduml