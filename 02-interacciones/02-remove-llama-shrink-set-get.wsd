@startuml sss
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825
skinparam sequenceArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #4527A0
skinparam sequenceLifeLineBackgroundColor #EDE7F6
skinparam sequenceParticipantBackgroundColor #D1C4E9
skinparam sequenceParticipantBorderColor #4527A0
skinparam actorBackgroundColor #EDE7F6
skinparam actorBorderColor #4527A0
skinparam sequenceGroupBorderColor #4527A0
skinparam sequenceGroupBackgroundColor #F3E5F5

title Interacción remove(i) → set/get → shrink()\nEjemplo: n = 6, i = 1, r = 3

actor "Usuario" as USR
participant "RootishArrayStack" as RAS
participant "set/get" as SETGET
participant "i2b" as I2B
participant "shrink()" as SHRINK
participant "blocks\n(ArrayStack<T*>)" as BLK
participant "Sistema\n(delete[])" as SYS

USR -> RAS : remove(1)
activate RAS

note right of RAS
  n = 6
  blocks.size() = 3
  Capacidad = 6
end note

group Fase 1: guardar el valor a eliminar
  RAS -> SETGET : get(1)
  activate SETGET
  SETGET -> I2B : i2b(1)
  activate I2B
  I2B --> SETGET : b
  deactivate I2B
  SETGET -> BLK : get(b)
  activate BLK
  BLK --> SETGET : T* bloque
  deactivate BLK
  note right of SETGET
    x = *(ptr + j)
  end note
  SETGET --> RAS : x
  deactivate SETGET
end

group Fase 2: desplazar a la izquierda
  loop j = i = 1; j < n−1 = 5; j++

    RAS -> SETGET : set(j, get(j + 1))
    activate SETGET

    SETGET -> I2B : i2b(j + 1)
    activate I2B
    I2B --> SETGET : b_orig
    deactivate I2B

    SETGET -> BLK : get(b_orig)
    activate BLK
    BLK --> SETGET : T* origen
    deactivate BLK

    SETGET -> I2B : i2b(j)
    activate I2B
    I2B --> SETGET : b_dest
    deactivate I2B

    SETGET -> BLK : get(b_dest)
    activate BLK
    BLK --> SETGET : T* destino
    deactivate BLK

    SETGET --> RAS : ok
    deactivate SETGET
  end
end

RAS -> RAS : n−−
note right of RAS
  n pasa de 6 a 5.
end note

group Fase 3: verificar si sobra capacidad
  RAS -> BLK : size()
  activate BLK
  BLK --> RAS : 3
  deactivate BLK

  note right of RAS
    (3−2)(3−1)/2 = 1
    n = 5
    1 >= 5 → false
    NO se llama a shrink()
  end note

  alt condición verdadera
    RAS -> SHRINK : shrink()
    activate SHRINK
    SHRINK -> BLK : remove(blocks.size()−1)
    activate BLK
    BLK --> SHRINK : T* bloque
    deactivate BLK
    SHRINK -> SYS : delete[] ptr
    activate SYS
    SYS --> SHRINK : ok
    deactivate SYS
    SHRINK --> RAS : fin
    deactivate SHRINK
  else condición falsa
    note right of RAS
      No se libera nada.
    end note
  end
end

RAS --> USR : x
deactivate RAS

note right of USR
  El usuario recibe el
  valor eliminado.
end note

@enduml