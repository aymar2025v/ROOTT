@startuml conssec
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825
skinparam sequenceArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #00695C
skinparam sequenceLifeLineBackgroundColor #E0F2F1
skinparam sequenceParticipantBackgroundColor #B2DFDB
skinparam sequenceParticipantBorderColor #00695C
skinparam actorBackgroundColor #E0F2F1
skinparam actorBorderColor #00695C

title Constructor — Diagrama de secuencia\nCreación de un RootishArrayStack<int>

actor "main()" as MAIN
participant "RootishArrayStack" as RAS
participant "blocks\n(ArrayStack<T*>)" as BLK
participant "array<T*>" as ARR

MAIN -> RAS : RootishArrayStack()
activate RAS

note right of RAS
  Comienza la construcción.
  Primero se inicializan los
  miembros, luego se ejecuta
  el cuerpo del constructor.
end note

group Inicialización de miembros
  RAS -> BLK : ArrayStack()
  activate BLK
  note right of BLK
    Constructor por defecto
    de ArrayStack<T*>.
  end note

  BLK -> ARR : array<T*>(1)
  activate ARR
  note right of ARR
    Crea un arreglo interno
    de punteros con capacidad 1.
    length = 1
  end note
  ARR --> BLK : ok
  deactivate ARR

  BLK -> BLK : n = 0
  note right of BLK
    ArrayStack vacío.
    Ningún puntero todavía.
  end note
  BLK --> RAS : ok
  deactivate BLK
end

group Cuerpo del constructor
  RAS -> RAS : n = 0
  note right of RAS
    RootishArrayStack vacío.
    Sin elementos lógicos.
  end note
end

RAS --> MAIN : objeto creado
deactivate RAS

note right of MAIN
  Estado final:
  n = 0
  blocks.size() = 0
  blocks.a.length = 1
  Sin bloques de datos.

  Listo para add().
end note

@enduml