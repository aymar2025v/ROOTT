@startuml shrinksec
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FBFB77
skinparam noteBorderColor #A80036
skinparam sequenceArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #A80036
skinparam sequenceLifeLineBackgroundColor #FEFECE
skinparam sequenceParticipantBackgroundColor #DDEEFF
skinparam sequenceParticipantBorderColor #A80036
skinparam actorBackgroundColor #EEFFEE
skinparam actorBorderColor #A80036
skinparam sequenceGroupBorderColor #A80036
skinparam sequenceGroupBackgroundColor #F8F8F8

title shrink() — Diagrama de secuencia\nEjemplo: n = 0, r = 3 bloques

actor "remove(i)" as REM
participant "RootishArrayStack" as RAS
participant "blocks\n(ArrayStack<T*>)" as BLK
participant "array<T*>" as ARR
participant "Sistema\n(delete[])" as SYS

REM -> RAS : shrink()
activate RAS

note right of RAS
  r = blocks.size() = 3
  n = 0
  Condición:
  (3−2)(3−1)/2 = 1 >= 0 → true
end note

group Iteración 1
  RAS -> BLK : remove(blocks.size() − 1) = remove(2)
  activate BLK
  BLK -> ARR : a[2]
  activate ARR
  ARR --> BLK : T* al bloque 2
  deactivate ARR
  note right of BLK
    Se elimina el último
    puntero del arreglo.
    blocks.size() pasa a 2.
  end note
  BLK --> RAS : T* bloque 2
  deactivate BLK

  RAS -> SYS : delete[] ptr_bloque2
  activate SYS
  note right of SYS
    Libera la memoria del
    bloque 2 (tamaño 3).
  end note
  SYS --> RAS : ok
  deactivate SYS

  note right of RAS
    r−− → r = 2
    Condición:
    (2−2)(2−1)/2 = 0 >= 0 → true
  end note
end

group Iteración 2
  RAS -> BLK : remove(blocks.size() − 1) = remove(1)
  activate BLK
  BLK -> ARR : a[1]
  activate ARR
  ARR --> BLK : T* al bloque 1
  deactivate ARR
  note right of BLK
    blocks.size() pasa a 1.
  end note
  BLK --> RAS : T* bloque 1
  deactivate BLK

  RAS -> SYS : delete[] ptr_bloque1
  activate SYS
  note right of SYS
    Libera el bloque 1 (tamaño 2).
  end note
  SYS --> RAS : ok
  deactivate SYS

  note right of RAS
    r−− → r = 1
    Condición:
    (1−2)(1−1)/2 = 0 >= 0 → true
  end note
end

group Iteración 3
  RAS -> BLK : remove(blocks.size() − 1) = remove(0)
  activate BLK
  BLK -> ARR : a[0]
  activate ARR
  ARR --> BLK : T* al bloque 0
  deactivate ARR
  note right of BLK
    blocks.size() pasa a 0.
  end note
  BLK --> RAS : T* bloque 0
  deactivate BLK

  RAS -> SYS : delete[] ptr_bloque0
  activate SYS
  note right of SYS
    Libera el bloque 0 (tamaño 1).
  end note
  SYS --> RAS : ok
  deactivate SYS

  note right of RAS
    r−− → r = 0
    Condición:
    r > 0 → false
    Se sale del while.
  end note
end

note right of RAS
  blocks.size() = 0
  n = 0
  Sin bloques.
end note

RAS --> REM : fin de shrink()
deactivate RAS

@enduml