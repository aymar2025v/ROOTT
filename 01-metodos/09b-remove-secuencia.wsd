@startuml removesec
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825
skinparam sequenceArrowThickness 1.3
skinparam sequenceLifeLineBorderColor #4527A0
skinparam sequenceLifeLineBackgroundColor #EDE7F6
skinparam sequenceParticipantBackgroundColor #D1C4E9
skinparam sequenceParticipantBorderColor #4527A0
skinparam actorBackgroundColor #EDE7F6
skinparam actorBorderColor #4527A0
skinparam sequenceGroupBorderColor #4527A0
skinparam sequenceGroupBackgroundColor #F3E5F5

title remove(i) — Diagrama de secuencia\nEjemplo: n = 6, i = 2, r = 3 bloques

actor "Usuario" as USR
participant "RootishArrayStack" as RAS
participant "blocks\n(ArrayStack<T*>)" as BLK
participant "i2b" as I2B
participant "Sistema\n(delete[])" as SYS

USR -> RAS : remove(2)
activate RAS

RAS -> RAS : x = get(2)
activate RAS
note right of RAS
  Se guarda el valor a
  eliminar antes de
  sobrescribirlo.
end note

RAS -> I2B : i2b(2)
activate I2B
I2B --> RAS : b
deactivate I2B

RAS -> BLK : get(b)
activate BLK
BLK --> RAS : T* al bloque
deactivate BLK

note right of RAS
  x = *(ptr + j)
end note
deactivate RAS

group Bucle de desplazamiento (j de 2 a 4)
  loop j = i = 2; j < n−1 = 5; j++

    RAS -> RAS : set(j, get(j + 1))
    activate RAS
    note right of RAS
      Copia el vecino derecho
      a la posición actual.
    end note

    RAS -> I2B : i2b(j + 1)
    activate I2B
    I2B --> RAS : b_origen
    deactivate I2B

    RAS -> BLK : get(b_origen)
    activate BLK
    BLK --> RAS : T* origen
    deactivate BLK

    RAS -> I2B : i2b(j)
    activate I2B
    I2B --> RAS : b_destino
    deactivate I2B

    RAS -> BLK : get(b_destino)
    activate BLK
    BLK --> RAS : T* destino
    deactivate BLK

    note right of RAS
      *(ptr_dest + jd) = *(ptr_orig + jo)
    end note
    deactivate RAS

  end
end

note right of RAS
  Después del bucle:
  el último elemento queda
  duplicado fuera del rango.
end note

RAS -> RAS : n−−
note right of RAS
  n pasa de 6 a 5.
  El duplicado queda fuera.
end note

RAS -> BLK : size()
activate BLK
BLK --> RAS : r = 3
deactivate BLK

alt (r−2)(r−1)/2 >= n
  note right of RAS
    (3−2)(3−1)/2 = 1
    n = 5
    1 >= 5 → false
    NO se llama a shrink()
  end note
else condición verdadera
  RAS -> RAS : shrink()
  RAS -> BLK : remove(blocks.size()−1)
  activate BLK
  BLK --> RAS : T* bloque sobrante
  deactivate BLK
  RAS -> SYS : delete[] ptr
  activate SYS
  SYS --> RAS : ok
  deactivate SYS
end

RAS --> USR : x (valor eliminado)
deactivate RAS

@enduml